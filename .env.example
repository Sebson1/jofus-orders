# ---- Required ----
ADMIN_KEY=change-this-password            # password for /admin
BASE_URL=https://jofus-orders.onrender.com # public URL of this app (SMS links + Paystack callback)
PORT=3000

# ---- Paystack (leave empty to run in "pay on pickup/delivery" mode) ----
PAYSTACK_SECRET_KEY=
# In Paystack -> Settings -> Webhooks set:  <BASE_URL>/api/paystack/webhook

# ---- SMS via mNotify (mnotify.com) – optional ----
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=Jofus

# ---- WhatsApp via Meta Business Cloud API – optional (wa.me links are used regardless) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---- Storage – optional. Without Supabase, data is saved to data/db.json,
#      which Render's free plan erases on every deploy/restart. ----
# Run supabase-setup.sql in your Supabase project first (creates table jofus_store).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
